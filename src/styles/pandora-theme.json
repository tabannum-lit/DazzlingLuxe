{
  "colors": {
    "cream": "#F3FAF3",
    "ivory": "#F6FCF7",
    "beige": "#DCEEDC",
    "warm-gold": "#C4E1C5",
    "deep-gold": "#6FB972",
    "blush": "#D9EFDA",
    "charcoal": "#2C2C2C",
    "soft-brown": "#5E6B60",
    "light-gold": "#E5F1E5",
    "gold-ink": "#265E28",
    "pale-rose": "#EAF6EA",
    "white": "#FFFFFF"
  },
  "typography": {
    "headings": "Cormorant Garamond, serif",
    "body": "Lato, -apple-system, sans-serif",
    "logo": "Great Vibes, cursive",
    "sizes": {
      "h1": "3.75rem",
      "h2": "3rem",
      "h3": "2.25rem",
      "h4": "1.875rem",
      "base": "1rem",
      "lg": "1.125rem"
    }
  },
  "spacing": {
    "section": "5rem",
    "container": "1.5rem",
    "grid-gap": "1.5rem",
    "product-padding": "1.25rem"
  },
  "shadows": {
    "header": "0 4px 20px rgba(196, 225, 197, 0.08)",
    "card": "0 4px 15px rgba(196, 225, 197, 0.10)",
    "hover": "0 20px 40px rgba(196, 225, 197, 0.15)"
  },
  "transitions": {
    "all": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
    "hover": "transform 0.4s ease"
  },
  "border-radius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "full": "9999px"
  },
  "z-index": {
    "header": "50",
    "cart": "100",
    "modal": "1000"
  }
}
